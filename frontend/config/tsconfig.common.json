{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "outDir": "./static/html/",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "dash-live": ["../src/main.tsx"],
      "@dashlive/*": ["../@types/@dashlive/*"]
    },
    "resolveJsonModule": true,
    "sourceMap": true,
    "target": "ES2023",
    "lib": ["es2024.promise"],
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ]
  },
  "include": [
    "../@types/global.d.ts",
    "../@types/*.d.ts",
    "../@types/@dashlive/*.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ]
}
